# AgentHub 配置（复制为 .env 后修改）
AGENTHUB_DB=sqlite:///data/agenthub.db
AGENTHUB_DATA_DIR=./data/snapshots
# 留空表示开发模式（不校验 API Key）
AGENTHUB_API_KEY=
# 以下仅 LLM Judge 指标需要（OpenAI 兼容接口）
AGENTHUB_LLM_BASE_URL=
AGENTHUB_LLM_API_KEY=
AGENTHUB_LLM_MODEL=
# 托管评测并发数：同时调用被测 Agent 的线程数（默认 4）
AGENTHUB_RUN_CONCURRENCY=4
